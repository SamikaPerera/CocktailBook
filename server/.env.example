# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file - it contains secrets.

# Port the Express server listens on
PORT=5000

# "development" or "production"
NODE_ENV=development

# MongoDB connection string.
# Local development (MongoDB installed on your PC):
#   mongodb://127.0.0.1:27017/cocktailbook
# MongoDB Atlas (Atlas -> Database -> Connect -> Drivers), used for deployment:
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cocktailbook?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cocktailbook

# Front-end URL(s) allowed to call this API (CORS). Comma-separate multiple values.
CLIENT_URL=http://localhost:5180,http://localhost:4180

# --- Used from Phase 2 (authentication) ---
# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Accounts created by "npm run seed" (optional - these are the defaults).
# Change the passwords before deploying!
SEED_MANAGER_EMAIL=manager@cocktailbook.test
SEED_MANAGER_PASSWORD=Manager123
SEED_BARTENDER_EMAIL=bartender@cocktailbook.test
SEED_BARTENDER_PASSWORD=Bartender123

# --- Used from Phase 5 (push notifications) ---
# Generated by: npm run generate-vapid  (generate ONCE; changing them breaks existing subscriptions)
# VAPID_SUBJECT must be a mailto: or https: contact address for the push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
