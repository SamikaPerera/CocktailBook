# Copy this file to ".env" and adjust if needed.
# Only variables starting with VITE_ are exposed to the browser code,
# so NEVER put secrets in this file.

# Base URL of the Express API.
# Leave EMPTY in development - Vite's proxy forwards /api to http://localhost:5000.
# In production set it to your Render URL, e.g. https://cocktailbook-api.onrender.com
VITE_API_URL=
